# Só arquivos e pastas do jogo entram na raiz do repositório.
/*
!/.gitignore
!/README.md
!/package.json
!/package-lock.json
!/index.html
!/script.js
!/style.css
!/projeto.pdf
!/assets/
!/css/
!/docs/
!/js/
!/tests/

# Dados locais de ferramentas, inclusive dentro das pastas do jogo.
.agents
AGENTS.md
.codex
.aws
.claude
.cursor
.aider*
.vscode
.idea
.env
.env.*
!.env.example

# Dependências, caches e arquivos temporários.
node_modules/
coverage/
.cache/
.npm/
.nyc_output/
*.log
*.tmp
*.swp
.DS_Store
Thumbs.db
